{
  "name": "fixtab",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Extensión de Chrome: guarda un grupo de pestañas fijadas y lo restaura con un botón o al iniciar.",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "node test/e2e/run.mjs",
    "check": "tsc -p jsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm check && pnpm test && pnpm test:e2e",
    "zip": "node scripts/pack.mjs",
    "assets": "node scripts/store-assets.mjs && python3 scripts/flatten_png.py store"
  },
  "packageManager": "pnpm@11.16.0",
  "devDependencies": {
    "@types/chrome": "^0.3.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
